# ---------- Core ----------
ENVIRONMENT=development            # development | production
DATABASE_URL=sqlite:///./rent.db   # Neon: postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
FRONTEND_URL=http://localhost:5173 # used for CORS, registration links and email links
EXTRA_CORS_ORIGINS=                # optional, comma separated

# ---------- Security ----------
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Encrypts Aadhaar/PAN numbers and Gmail App Passwords. NEVER change it after go-live.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Shared secret for POST /api/jobs/run-daily (also stored as a GitHub Actions secret)
CRON_SECRET=change-me-too
COOKIE_SECURE=false                # true in production (HTTPS)
COOKIE_SAMESITE=lax                # lax when Vercel proxies /api (default setup); none if the API is called cross-site

# ---------- Storage ----------
STORAGE_BACKEND=local              # local | supabase
LOCAL_UPLOAD_DIR=./uploads
SUPABASE_URL=                      # https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=              # service_role key (server only!)
SUPABASE_BUCKET=rent-private       # must be a PRIVATE bucket

# ---------- Email ----------
EMAIL_BACKEND=console              # smtp (real Gmail) | console (print to log, for local dev)
# System Gmail used for password-reset emails (and owner notifications if the owner has no Gmail set)
SYSTEM_GMAIL_ADDRESS=
SYSTEM_GMAIL_APP_PASSWORD=

REGISTRATION_RATE_LIMIT=10         # public registration submissions per IP per hour
